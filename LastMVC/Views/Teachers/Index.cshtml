@using firstMVC.Models;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model IEnumerable<Teacher>
<h1>Teacher view</h1>
<a class="btn btn-secondary btn-lg" asp-action="New"><span>Add New</span></a>
<br />
<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Name</th>
            <th scope="col">Address</th>
            <th scope="col">Phone</th>
            <th scope="col">Update</th>
            <th scope="col">delete</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <th>@item.Id</th>
                <td>@item.Name</td>
                <td>@item.address</td>
                <td>@item.phone</td>
                <td>
                    <a asp-controller="Teachers" asp-action="Update" asp-route-Id="@item.Id" class="btn btn-success"><span>update</span> <i class="bi bi-pencil" ></i> </a>
                </td>
                <th>
                    <a asp-controller="Teachers" asp-action="Delete" asp-route-Id="@item.Id" class="btn btn-danger"><span>delete</span> <i class="bi bi-pencil"></i></a>
                </th>

            </tr>
        }
    </tbody>
</table>
